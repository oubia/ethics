# All-in-One Dockerfile for Azure App Service
# Combines: Frontend (React + Nginx) + Backend (FastAPI) + Ollama + Caddy

# Stage 1: Build React frontend
FROM node:18-alpine AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend ./
ARG REACT_APP_BASE_URL=http://localhost:8000/
ENV REACT_APP_BASE_URL=$REACT_APP_BASE_URL
RUN npm run build

# Stage 2: Runtime - All services
FROM python:3.11-slim

WORKDIR /app
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install all dependencies at once
RUN apt-get update && \
    apt-get install -y \
    git curl build-essential ffmpeg \
    nginx gettext \
    supervisor \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install Ollama
RUN curl -fsSL https://ollama.ai/install.sh | sh

# Copy backend code
COPY backend/requirements.txt ./backend/
RUN python -m pip install --upgrade pip && \
    python -m pip install -r ./backend/requirements.txt

COPY backend ./backend
COPY backend/config.json ./backend/

# Copy frontend build output
COPY --from=frontend-builder /app/frontend/build ./frontend/build

# Setup Nginx for frontend with 600s timeouts for streaming
RUN echo 'upstream backend {' > /etc/nginx/conf.d/frontend.conf.template && \
    echo '    server localhost:8000;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    keepalive 32;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '}' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo 'server {' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    listen 3000;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    server_name _;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    charset utf-8;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    # Critical timeouts for long-running LLM inference (10 minutes)' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    proxy_connect_timeout 600s;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    proxy_send_timeout 600s;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    proxy_read_timeout 600s;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    # Streaming support - disable buffering' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    proxy_buffering off;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    proxy_request_buffering off;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    proxy_http_version 1.1;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    # Chat endpoint with streaming responses' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    location /chat/ {' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_pass http://backend/chat/;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_http_version 1.1;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header Host $host;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Real-IP $remote_addr;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Forwarded-Proto $scheme;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header Connection "";' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    }' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    # Audio processing endpoint' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    location /process_audio/ {' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_pass http://backend/process_audio/;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_http_version 1.1;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header Host $host;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Real-IP $remote_addr;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Forwarded-Proto $scheme;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header Connection "";' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    }' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    # Health check endpoint' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    location /health {' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_pass http://backend/health;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    }' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    # API endpoints' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    location /api/ {' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_pass http://backend/api/;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_http_version 1.1;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header Host $host;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Real-IP $remote_addr;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header X-Forwarded-Proto $scheme;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        proxy_set_header Connection "";' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    }' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    # Serve React frontend' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    location / {' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        root /app/frontend/build;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '        try_files $uri /index.html;' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '    }' >> /etc/nginx/conf.d/frontend.conf.template && \
    echo '}' >> /etc/nginx/conf.d/frontend.conf.template && \
    rm -f /etc/nginx/sites-enabled/default

# Setup supervisor to manage multiple processes
RUN mkdir -p /var/log/supervisor && \
    echo '[supervisord]' > /etc/supervisor/conf.d/supervisord.conf && \
    echo 'nodaemon=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'logfile=/var/log/supervisor/supervisord.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'pidfile=/var/run/supervisord.pid' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'loglevel=info' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'childlogdir=/var/log/supervisor' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[unix_http_server]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'file=/var/run/supervisor.sock' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[supervisorctl]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'serverurl=unix:///var/run/supervisor.sock' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[rpcinterface:supervisor]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'supervisor.rpcinterface_factory = supervisor.rpcinterface:make_main_rpcinterface' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[program:nginx]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'command=/usr/sbin/nginx -g "daemon off;"' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile=/var/log/supervisor/nginx.err.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile=/var/log/supervisor/nginx.out.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[program:ollama]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'command=/usr/bin/ollama serve' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile=/var/log/supervisor/ollama.err.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile=/var/log/supervisor/ollama.out.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'priority=1' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo '[program:fastapi]' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'command=bash -c "sleep 5 && cd /app/backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload"' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'directory=/app/backend' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autostart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'autorestart=true' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stderr_logfile=/var/log/supervisor/fastapi.err.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile=/var/log/supervisor/fastapi.out.log' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'stdout_logfile_maxbytes=0' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'priority=999' >> /etc/supervisor/conf.d/supervisord.conf && \
    echo 'environment=PYTHONPATH=/app/backend/src,CHROMA_DIR=/app/Vectorestor,OLLAMA_LLM_ENDPOINT=http://localhost:11434/,OLLAMA_EMBEDDINGS_ENDPOINT=http://localhost:11434/,REQUEST_TIMEOUT=600,OLLAMA_REQUEST_TIMEOUT=600,STREAMING_TIMEOUT=600' >> /etc/supervisor/conf.d/supervisord.conf

# Create required directories
RUN mkdir -p /app/Vectorestor /root/.ollama

# Expose ports
EXPOSE 3000 8000 11434

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:3000 || exit 1

# Set environment variables
ENV PORT=3000
ENV PYTHONPATH=src
ENV CHROMA_DIR=/app/Vectorestor
ENV OLLAMA_LLM_ENDPOINT=http://localhost:11434/
ENV OLLAMA_EMBEDDINGS_ENDPOINT=http://localhost:11434/

# Start supervisor to manage all services
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
