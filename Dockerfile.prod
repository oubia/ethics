# Stage 1: Build React app
FROM node:18-alpine as builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy all frontend files
COPY frontend ./

# Build with explicit env var
ARG REACT_APP_BASE_URL=https://api.ethics.oubia.me/
ENV REACT_APP_BASE_URL=$REACT_APP_BASE_URL
RUN npm run build

# Stage 2: Run with lightweight nginx
FROM nginx:alpine
RUN apk add --no-cache gettext

COPY --from=builder /app/build /usr/share/nginx/html
RUN printf 'server {\n  listen ${PORT:-80};\n  location / {\n    root /usr/share/nginx/html;\n    try_files $$uri /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf.template

EXPOSE 80
ENV PORT=80
CMD ["sh", "-c", "envsubst '$PORT' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]