# Stage 1: Build React app
FROM node:18-alpine as builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci --only=production && npm ci

# Copy all frontend files
COPY frontend ./

# Build with explicit env var
ARG REACT_APP_BASE_URL=https://api.ethics.oubia.me/
ENV REACT_APP_BASE_URL=$REACT_APP_BASE_URL
RUN npm run build

# Stage 2: Run with lightweight nginx
FROM nginx:alpine

# Copy built app from builder
COPY --from=builder /app/build /usr/share/nginx/html

# Copy nginx config
RUN echo 'server { listen 3000; location / { root /usr/share/nginx/html; try_files $uri /index.html; } }' > /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
