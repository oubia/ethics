# Multi-stage Dockerfile for production deployment
# This Dockerfile runs the full stack: Caddy + Frontend + Backend + Ollama
# For Azure Container Instances

# We'll use a docker-compose approach but wrapped in a single container
# using supervisord to manage multiple services

FROM ubuntu:22.04

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && \
    apt-get install -y \
    python3.11 \
    python3-pip \
    curl \
    git \
    docker.io \
    docker-compose \
    supervisord \
    npm \
    nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy docker-compose and related files
COPY docker-compose.prod.yml .
COPY Caddyfile .
COPY backend ./backend
COPY frontend ./frontend
COPY Ollama ./Ollama
COPY .env .

# Install Python dependencies for backend
WORKDIR /app/backend
RUN python3.11 -m pip install --upgrade pip && \
    python3.11 -m pip install --no-cache-dir -r requirements.txt

# Build frontend
WORKDIR /app/frontend
RUN npm install && npm run build

WORKDIR /app

# Create entrypoint script to run docker-compose
RUN mkdir -p /scripts && \
    echo '#!/bin/bash' > /scripts/entrypoint.sh && \
    echo 'set -e' >> /scripts/entrypoint.sh && \
    echo 'cd /app' >> /scripts/entrypoint.sh && \
    echo 'exec docker-compose -f docker-compose.prod.yml up' >> /scripts/entrypoint.sh && \
    chmod +x /scripts/entrypoint.sh

EXPOSE 80 443

ENTRYPOINT ["/scripts/entrypoint.sh"]
