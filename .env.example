PYTHONPATH="src"

# Persisted Chroma directory inside the backend container
# Make sure your compose mounts a host directory to this path (see docker-compose files)
CHROMA_DIR="/app/Vectorestor"

# Use the Docker service name so the backend can reach Ollama over the compose network
OLLAMA_LLM_ENDPOINT=http://ollama:11434/
OLLAMA_EMBEDDINGS_ENDPOINT=http://ollama:11434/

# Optional: if building/running the CRA dev server, this is used by the frontend to call the backend
# For local single-VM deploy behind Caddy, set this to your public API URL (e.g., https://api.example.me/)
REACT_APP_BASE_URL="http://127.0.0.1:8000/"